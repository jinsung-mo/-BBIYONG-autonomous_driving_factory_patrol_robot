#!/usr/bin/env bash
# Safe operator entrypoint. Launch commands use exec so Ctrl+C reaches ROS directly.
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SOURCE_WORKSPACE="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
if [[ -n "${BBIYONG_WS:-}" ]]; then
  WORKSPACE_DIR="$BBIYONG_WS"
elif [[ -f "$HOME/bbiyong_ros2_ws/install/setup.bash" ]]; then
  WORKSPACE_DIR="$HOME/bbiyong_ros2_ws"
else
  WORKSPACE_DIR="$SOURCE_WORKSPACE"
fi
YDLIDAR_WORKSPACE="${YDLIDAR_WS:-$HOME/ydlidar_ros2_ws}"
RF2O_WORKSPACE="${RF2O_WS:-$HOME/rf2o_ws}"

die() { echo "bbiyong: $*" >&2; exit 2; }
require_file() { [[ -f "$1" ]] || die "file not found: $1"; }
require_topic() {
  ros2 topic list 2>/dev/null | grep -Fxq "$1" ||
    die "required topic is unavailable: $1"
}
refuse_legacy_cmd_vel_publishers() {
  if pgrep -f '[e]xplore.py' >/dev/null; then
    die "legacy explore.py is running; stop it before starting Nav2 exploration"
  fi
  if pgrep -f '[t]eleop_node.py' >/dev/null; then
    die "legacy teleop_node.py bypasses the safety mux; run ~/calib/teleop_down.sh first"
  fi
}
source_workspace() {
  require_file /opt/ros/humble/setup.bash
  require_file "$YDLIDAR_WORKSPACE/install/setup.bash"
  require_file "$RF2O_WORKSPACE/install/setup.bash"
  require_file "$WORKSPACE_DIR/install/setup.bash"
  # ROS setup scripts reference optional variables that are unset under nounset.
  # Keep errexit enabled so a missing or failing workspace still stops the operator command.
  set +u
  # shellcheck disable=SC1091
  source /opt/ros/humble/setup.bash
  # shellcheck disable=SC1090
  source "$YDLIDAR_WORKSPACE/install/setup.bash"
  # shellcheck disable=SC1090
  source "$RF2O_WORKSPACE/install/setup.bash"
  # shellcheck disable=SC1090
  source "$WORKSPACE_DIR/install/setup.bash"
  set -u
}
usage() {
  cat <<'EOF'
Usage:
  bbiyong mapping
  bbiyong save-map <output-prefix>
  bbiyong localize <map.yaml>
  bbiyong navigate <map.yaml> <vehicle.yaml> <nav2.yaml>
  bbiyong control <vehicle.yaml>
  bbiyong explore <map-output-prefix> [nav2.yaml]
  bbiyong arm-autonomy
  bbiyong stop
  bbiyong status

Nav2 exploration overlays the existing ~/calib/stack_up.sh processes. It starts
DISARMED. In another terminal, run "bbiyong arm-autonomy" only after checking
the Nav2 launch output. Run "bbiyong stop" for an immediate software e-stop.
EOF
}

[[ $# -ge 1 ]] || { usage; exit 2; }
command="$1"
shift
source_workspace

case "$command" in
  mapping)
    [[ $# -eq 0 ]] || die "mapping takes no arguments"
    exec ros2 launch bbiyong_bringup mapping.launch.py odom_source:=rf2o allow_unmeasured_lidar:=true
    ;;
  save-map)
    [[ $# -eq 1 ]] || die "save-map requires an output prefix"
    mkdir -p "$(dirname "$1")"
    exec ros2 run bbiyong_bringup save_map "$1"
    ;;
  localize)
    [[ $# -eq 1 ]] || die "localize requires map.yaml"
    require_file "$1"
    exec ros2 launch bbiyong_bringup localization.launch.py map:="$1" odom_source:=rf2o allow_unmeasured_lidar:=true
    ;;
  navigate)
    [[ $# -eq 3 ]] || die "navigate requires map.yaml vehicle.yaml nav2.yaml"
    require_file "$1"; require_file "$2"; require_file "$3"
    exec ros2 launch bbiyong_bringup navigation.launch.py map:="$1" vehicle_config:="$2" nav2_params:="$3" odom_source:=wheel
    ;;
  control)
    [[ $# -eq 1 ]] || die "control requires vehicle.yaml"
    require_file "$1"
    exec ros2 launch bbiyong_bringup control.launch.py vehicle_config:="$1"
    ;;
  explore)
    [[ $# -ge 1 && $# -le 2 ]] ||
      die "explore requires map-output-prefix and optionally nav2.yaml"
    refuse_legacy_cmd_vel_publishers
    require_topic /map
    require_topic /odom
    require_topic /scan_filtered
    map_output="$1"
    mkdir -p "$(dirname "$map_output")"
    if [[ $# -eq 2 ]]; then
      require_file "$2"
      exec ros2 launch bbiyong_bringup exploration.launch.py \
        map_output:="$map_output" nav2_params:="$2"
    fi
    exec ros2 launch bbiyong_bringup exploration.launch.py map_output:="$map_output"
    ;;
  arm-autonomy)
    [[ $# -eq 0 ]] || die "arm-autonomy takes no arguments"
    refuse_legacy_cmd_vel_publishers
    require_topic /scan_filtered
    echo "Arming Nav2 (run this only after 'Managed nodes are active')..."
    timeout 25 ros2 run bbiyong_base control_command arm ||
      die "arm failed; keep the explore terminal running and confirm both nodes started"
    echo "Nav2 autonomy armed. Keep a second terminal ready with: bbiyong stop"
    ;;
  stop)
    [[ $# -eq 0 ]] || die "stop takes no arguments"
    timeout 8 ros2 run bbiyong_base control_command stop || true
    ;;
  status)
    [[ $# -eq 0 ]] || die "status takes no arguments"
    ros2 node list
    ros2 topic list | grep -E '^/(scan|odom|map|cmd_vel|bbiyong)' || true
    echo
    echo "/cmd_vel publishers (exactly one bbiyong_cmd_mux publisher is expected):"
    ros2 topic info /cmd_vel --verbose || true
    ;;
  *) usage; exit 2 ;;
esac
