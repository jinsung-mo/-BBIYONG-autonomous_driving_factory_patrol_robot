def checkoutMergeRequestSource() {
    def sourceBranch = env.gitlabSourceBranch?.trim()

    if (!sourceBranch) {
        error('GitLab MR source branch 정보를 찾지 못했습니다.')
    }

    checkout([
        $class: 'GitSCM',
        branches: [[name: "*/${sourceBranch}"]],
        userRemoteConfigs: [[
            url: 'https://lab.ssafy.com/s15-webmobile3-sub1/S15P11E101.git',
            credentialsId: 'gitlab-bbiyong-read'
        ]],
        extensions: [[$class: 'CleanBeforeCheckout']]
    ])
}

def sendMattermostNotification(boolean success) {
    def branch = env.gitlabSourceBranch ?: '브랜치 정보 없음'
    def commitMessage = sh(
        script: 'git log -1 --pretty=%s 2>/dev/null || true',
        returnStdout: true
    ).trim() ?: '커밋 메시지 정보 없음'
    def statusText = success ? '[CI] System MR 검증 성공' : '[CI] System MR 검증 실패'
    def iconEmoji = success ? ':jenkins1:' : ':angry_jenkins:'
    def text = "## ${iconEmoji} ${statusText}\n" +
        "**MR source 브랜치:** `${branch}`\n" +
        "**최신 커밋:** ${commitMessage}"

    writeFile(
        file: 'mattermost-payload.json',
        text: groovy.json.JsonOutput.toJson([
            text      : text,
            username  : 'Jenkins',
            icon_emoji: iconEmoji
        ])
    )

    withCredentials([string(credentialsId: 'mattermost-webhook', variable: 'MM_WEBHOOK')]) {
        sh '''
            curl --silent --show-error --fail --request POST \
              --header 'Content-Type: application/json' \
              --data-binary @mattermost-payload.json \
              "$MM_WEBHOOK" || true
        '''
    }
}

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout MR Source') {
            steps {
                script {
                    checkoutMergeRequestSource()
                }
            }
        }

        stage('Test') {
            steps {
                dir('BE_system') {
                    sh '''
                        set -e
                        export TEST_DB_PORT=3308
                        echo "=== Starting MySQL test container ==="
                        docker compose --project-name bbiyong-system-verify-test -f compose.test.yaml up -d --wait
                        echo "=== MySQL container started successfully ==="
                        docker compose --project-name bbiyong-system-verify-test -f compose.test.yaml ps
                        echo "=== Running tests ==="
                        TEST_DATASOURCE_URL=jdbc:mysql://127.0.0.1:${TEST_DB_PORT}/bbiyong_test \
                        TEST_DATASOURCE_USERNAME=test \
                        TEST_DATASOURCE_PASSWORD=test \
                        ./gradlew test --no-daemon
                    '''
                }
            }
            post {
                always {
                    dir('BE_system') {
                        sh 'TEST_DB_PORT=3308 docker compose --project-name bbiyong-system-verify-test -f compose.test.yaml down -v --remove-orphans || true'
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                sendMattermostNotification(true)
            }
        }
        failure {
            script {
                sendMattermostNotification(false)
            }
        }
    }
}
